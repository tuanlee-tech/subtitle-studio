{
  "name": "sub-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Video subtitle tool: whisper transcript -> SRT -> Remotion burn-in",
  "bin": {
    "sub-tool": "./cli.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.js",
    "sub": "node cli.mjs",
    "studio": "remotion studio",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "build-portable": "node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "^4.0.529",
    "@remotion/cli": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "commander": "^15.0.0",
    "driver.js": "^1.8.0",
    "express": "^5.2.1",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
